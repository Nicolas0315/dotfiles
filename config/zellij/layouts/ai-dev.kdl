// 単一エージェント開発レイアウト: file-tree + shell + AI agent pane
// 起動: zellij --new-session-with-layout ai-dev --session ai-dev  (Ghostty: cmd+shift+a)
// agent pane は素のシェル。c(claude) / cx(codex) / g(gemini) のエイリアスで手動起動する。
layout {
    default_tab_template {
        pane size=1 borderless=true {
            plugin location="zellij:tab-bar"
        }
        children
        pane size=2 borderless=true {
            plugin location="zellij:status-bar"
        }
    }

    tab name="dev" focus=true split_direction="vertical" {
        pane size="25%" name="tree" {
            command "ft"
        }
        pane split_direction="horizontal" {
            pane size="60%" name="shell" focus=true
            pane size="40%" name="agent"
        }
    }

    tab name="logs" {
        pane name="logs"
    }
}
