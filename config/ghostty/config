# =========================================================
# Ghostty
# =========================================================

font-family = "UDEV Gothic"
font-size = 14
font-feature = -calt
font-feature = -liga
theme = dark:Catppuccin Mocha,light:Catppuccin Latte

window-padding-x = 8
window-padding-y = 8
window-padding-balance = true

cursor-style = block
cursor-style-blink = true

shell-integration = detect
shell-integration-features = cursor,sudo,title,ssh-env
notify-on-command-finish = unfocused

clipboard-read = allow
clipboard-write = allow
copy-on-select = clipboard

macos-titlebar-style = transparent
macos-window-shadow = true
macos-option-as-alt = left
macos-auto-secure-input = true
macos-secure-input-indication = true
mouse-hide-while-typing = true

window-inherit-working-directory = true
working-directory = /Users/s30519/work


# =========================================================
# Environment
# =========================================================

env = EDITOR=vim
env = VISUAL=vim
env = SHELL=/bin/zsh


# =========================================================
# Zellij-first keybinds
# =========================================================

# New panes
keybind = cmd+enter=text:zellij\ action\ new-pane\ --direction\ down\r
keybind = cmd+shift+enter=text:zellij\ action\ new-pane\ --direction\ right\r

# Move focus
keybind = cmd+left=text:zellij\ action\ move-focus\ left\r
keybind = cmd+right=text:zellij\ action\ move-focus\ right\r
keybind = cmd+up=text:zellij\ action\ move-focus\ up\r
keybind = cmd+down=text:zellij\ action\ move-focus\ down\r

# Resize
keybind = cmd+shift+left=text:zellij\ action\ resize\ increase\ left\r
keybind = cmd+shift+right=text:zellij\ action\ resize\ increase\ right\r

# Close pane
keybind = cmd+w=text:zellij\ action\ close-pane\r

# Session launcher
keybind = cmd+g=text:zellij\ --new-session-with-layout\ ghostty-vscode\ --session\ ghostty-vscode\r
