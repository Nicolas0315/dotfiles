# Ghostty config — macOS 開発環境
# 実行時リロード: cmd+shift+,
# 全デフォルト+説明を見る: /Applications/Ghostty.app/Contents/MacOS/ghostty +show-config --default --docs
# テーマ一覧: /Applications/Ghostty.app/Contents/MacOS/ghostty +list-themes

# --- フォント ---
# JetBrainsMono Nerd Font Mono = 等幅+アイコングリフ(starship/lsd等のプロンプト表示用)。
# フォールバックは UDEV Gothic。ASCII が JetBrains Mono 由来で日本語グリフがその厳密に2倍幅のため、
# 主フォントのセル幅と整数比で一致する。Hiragino Sans はプロポーショナルで整数比にならず、
# lazygit/btop/tmux ステータス等の TUI で日本語行だけ列がずれる。
# 派生の JPDOC 版は「−」「≡」等の曖昧幅文字を全角にするため TUI が崩れる。素の UDEV Gothic を使う。
font-family = JetBrainsMono Nerd Font Mono
font-family = UDEV Gothic
font-size = 14
# 日本語フォントで「ます」「株式会社」等が合字化するのを抑止(コーディング用合字 calt は残る)。
font-feature = -dlig
# Retina で線が細く見えるのを補正。
font-thicken = true

# --- テーマ / 配色 ---
# 同梱テーマ。好みに応じ +list-themes から差し替え可。
theme = TokyoNight Night
background-opacity = 1.0
background-blur-radius = 0
# ターミナル色を Display P3 として解釈したい場合は次を有効化。発色は鮮やかになるが
# テーマ作者が意図した sRGB 値からはずれるため既定(srgb)のままにしてある。
# window-colorspace = display-p3

# --- 描画品質 ---
# 半透明背景では赤/緑など補色の組み合わせでグリフ縁に暗いフリンジが出る。linear-corrected は
# それを消しつつ、native と比べた文字の太さの変化を補正する(linear 単体だと細く/太くなる)。
alpha-blending = native
# TUI が背景と同色の前景色を指定したときの「見えない文字」を防ぐ WCAG コントラスト下限。
minimum-contrast = 1.1
# 行の高さを1割広げる。日英混在の長い出力で行の走査性が上がる。
adjust-cell-height = 10%
# エージェント実行の長大な出力を遡れるように既定10MB→10MB(サーフェス単位・遅延確保)。
scrollback-limit = 10000000

# --- ウィンドウ / macOS 挙動 ---
# Alt+英字をメタキーとして送る。tmux/zsh/Claude Code のキーバインドで必須。
macos-option-as-alt = true
macos-titlebar-style = tabs
window-padding-x = 8
window-padding-y = 6
window-padding-balance = true
# 再起動・クラッシュ後にウィンドウ/タブ構成を復元。
window-save-state = always
mouse-hide-while-typing = true
mouse-scroll-multiplier = 2
# 選択した瞬間にクリップボードへ。
copy-on-select = clipboard
clipboard-read = allow
clipboard-write = allow
cursor-style = block
cursor-style-blink = false
# 新規タブ/分割は現在の作業ディレクトリを継承(開発作業で頻用)。
window-inherit-working-directory = true
# リサイズ時の寸法オーバーレイを非表示。
resize-overlay = never
# タブ/分割を閉じるときの確認を出さない。
confirm-close-surface = false
# stable チャンネル: 更新は通知のみ、自動DLしない。
auto-update = check

# --- シェル統合 ---
# detect で zsh/bash/fish を自動判定。
shell-integration = detect
# ssh-terminfo: SSH接続時に xterm-ghostty terminfo をリモートへ自動配布(リモートの表示崩れ防止)。
# ssh-env: TERM 等の環境をSSH先へ伝播。 sudo: sudo 実行時も terminfo を保持。
# cursor/title はデフォルト機能なので明示的に残す。
shell-integration-features = cursor,title,sudo,ssh-env,ssh-terminfo

# 非フォーカスの分割ペインをわずかに暗くして視線誘導。
unfocused-split-opacity = 0.9
# 分割の境界線。既定は背景色と同化して3分割以上で境目が読めなくなる。
split-divider-color = #3b4261

# --- キーバインド: ペイン分割 / 移動(開発作業向け) ---
# 分割の実体は herdr が持つ。Ghostty 自身の new_split で作った surface は herdr の
# 永続化・サイドバー・エージェント状態・テレメトリの全てから外れる「消える作業場所」に
# なるため、cmd 系は herdr の prefix(ctrl+b = \x02)へ転送して系統を1本にしている。
# 対応する herdr 側の既定キーは herdr --default-config の [keys] を参照。
keybind = cmd+d=text:\x02v
keybind = cmd+shift+d=text:\x02-
keybind = cmd+[=text:\x02\x1b[Z
keybind = cmd+]=text:\x02\t
keybind = cmd+enter=text:\x02z
keybind = cmd+opt+left=text:\x02h
keybind = cmd+opt+down=text:\x02j
keybind = cmd+opt+up=text:\x02k
keybind = cmd+opt+right=text:\x02l
# herdr のリサイズはモーダル(入ってから矢印)なので、方向別4キーは1キーに畳む。
keybind = cmd+ctrl+r=text:\x02r

# --- クイックターミナル ---
# どの画面からでも cmd+` でドロップダウン起動(macOSのアクセシビリティ許可が必要)。
quick-terminal-position = top
# 既定0.2秒は「思い立って叩く」用途には待たされる。
quick-terminal-animation-duration = 0.1
keybind = global:cmd+grave_accent=toggle_quick_terminal
