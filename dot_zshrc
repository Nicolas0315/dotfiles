# shellcheck shell=sh disable=SC1091
if [ -f "$HOME/.config/dev-env/profile.sh" ]; then
  . "$HOME/.config/dev-env/profile.sh"
fi

# Local non-shared secrets (incl. OP_SERVICE_ACCOUNT_TOKEN). Values stay outside shared docs/dotfiles.
# op の非対話認証トークンを先に読み込むため、APIキー取得より前に source する。
if [ -f "$HOME/.config/dev-env/secrets.local.sh" ]; then
  . "$HOME/.config/dev-env/secrets.local.sh"
fi

# opencode Go — API key via 1Password.
# Keep shell startup non-interactive; set OPENCODE_ALLOW_INTERACTIVE_1PASSWORD=1 only for a deliberate one-off refresh.
if [ -z "$OPENCODE_API_KEY" ] && { [ -n "$OP_SERVICE_ACCOUNT_TOKEN" ] || [ "$OPENCODE_ALLOW_INTERACTIVE_1PASSWORD" = "1" ]; }; then
  export OPENCODE_API_KEY="$(op item get h6vmnh3vgibyqftd7dqnbeati4 --fields '認証情報' --reveal 2>/dev/null)"
fi

if [ -f "$HOME/scripts/aws-saml-login.zsh" ]; then
  . "$HOME/scripts/aws-saml-login.zsh"
fi

# Added by LM Studio CLI (lms)
case ":$PATH:" in
  *":$HOME/.lmstudio/bin:"*) ;;
  *) export PATH="$PATH:$HOME/.lmstudio/bin" ;;
esac
# End of LM Studio CLI section

if [ -n "${ZSH_VERSION:-}" ] && command -v mise >/dev/null 2>&1; then
  eval "$(mise activate zsh)"
fi

if [ -n "${ZSH_VERSION:-}" ]; then
  typeset -U path PATH
fi
