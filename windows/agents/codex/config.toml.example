# Portable Windows Codex defaults.
# Keep machine-specific MCP, project trust, hook hashes, browser pipes,
# credentials, and runtime state in %USERPROFILE%\.codex\config.toml only.

model = "gpt-5.6-terra"
model_reasoning_effort = "medium"
approval_policy = "never"
sandbox_mode = "danger-full-access"
service_tier = "default"
model_verbosity = "medium"
model_reasoning_summary = "auto"
web_search = "live"

[agents]
max_concurrent_threads_per_session = 3
